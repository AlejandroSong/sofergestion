# Project URL (Settings → API)
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"

# anon public key (Settings → API) — never commit the service_role key
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# In Authentication → URL Configuration add:
# Site URL: http://localhost:3000
# Redirect URLs: http://localhost:3000/** and http://localhost:3001/**
#
# Google Client ID / Secret stay in Supabase → Authentication → Providers → Google.
# In Google Cloud, authorized redirect URI must be:
# https://YOUR_PROJECT.supabase.co/auth/v1/callback
